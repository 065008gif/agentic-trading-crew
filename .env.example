# Copy this file to .env and fill in YOUR values. Never commit .env (it is in .gitignore).

# ---- Alpaca PAPER keys (app.alpaca.markets -> make sure "Paper" is selected -> API Keys)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# ---- Which watch-list this computer trades: A (Akshit), B or C (config/portfolios.json)
ACCOUNT_LABEL=A

# ---- Free LLMs, tried in this order. Leave a key blank to skip that provider.
LLM_CHAIN=groq,groq_backup,groq_backup2,openrouter,ollama_cloud
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BACKUP_MODEL=openai/gpt-oss-20b
# third Groq model, with its own free daily quota (used when the first two are used up for the day)
GROQ_BACKUP2_MODEL=qwen/qwen3.8-27b
# Optional extra free fallbacks:
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free
OLLAMA_API_KEY=
OLLAMA_CLOUD_MODEL=gpt-oss:120b

# Seconds to wait between agents on Groq (keeps you under the free tokens-per-minute limit)
LLM_PAUSE_SECONDS=12
# 1 = run the Quant and News agents in parallel (faster, uses more tokens per minute)
PARALLEL_ANALYSTS=0

# ---- Web interface: password needed when you open it through ngrok
APP_PASSWORD=
APP_PORT=8000
